{
  "enabled": true,
  "sandboxUserShell": true,
  "permissionPromptTimeoutSeconds": 600,
  "network": {
    "allowedDomains": ["*"],
    "deniedDomains": []
  },
  "filesystem": {
    "denyRead": ["/home/marc/.config"],
    "allowRead": ["/home/marc", "/home/marc/.config/dotfiles"],
    "allowWrite": ["/home/marc", "/home/marc/.config/dotfiles"],
    "denyWrite": ["/home/marc/.config", ".env", ".env.*", "*.pem", "*.key"]
  }
}
